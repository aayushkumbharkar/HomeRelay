{
  "name": "homerelay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:mcp": "npm run build && node --test dist/tests/integration/mcp.test.js",
    "test:unit": "npm run build && node --test dist/tests/unit/*.test.js",
    "test:integration": "npm run build && node --test --test-concurrency=1 dist/tests/integration/*.test.js",
    "start:mcp": "node --env-file=.env dist/src/mcp-server.js",
    "start:web": "node --env-file=.env dist/src/web.js",
    "db:migrate": "npm run build && node --env-file=.env dist/scripts/migrate.js",
    "db:seed": "npm run build && node --env-file=.env dist/scripts/seed.js",
    "test:e2e": "npm run build && node --test dist/tests/e2e/*.test.js",
    "start:production:web": "node dist/src/web.js",
    "start:production:mcp": "node dist/scripts/migrate.js && node dist/scripts/seed.js && node dist/src/mcp-server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "node": "24.22.0",
    "typescript": "7.0.2"
  }
}
